# ---------------------------------------------------------------
# Armario do Diogo - variaveis de ambiente
# Copia este ficheiro para server/.env e preenche os valores.
# NUNCA facas commit do .env com credenciais reais.
# ---------------------------------------------------------------

# Ligacao ao PostgreSQL (obrigatoria).
# Local:  postgresql://postgres:password@localhost:5432/armario_diogo?schema=public
# Render: usa a "Internal Database URL" da base de dados criada no Render.
#
# Importante: a base de dados tem de estar em UTF8 (os icones sao emojis).
# O Render cria sempre em UTF8; num PostgreSQL local em Windows confirma com
#   CREATE DATABASE armario_diogo WITH ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL="postgresql://utilizador:password@localhost:5432/armario_diogo?schema=public"

# Porta da API. No Render e definida automaticamente.
PORT=4000

# development | production
NODE_ENV=development

# Segredo para assinar as sessoes dos pais (minimo 16 caracteres).
# Gera um valor aleatorio, por exemplo com:  openssl rand -base64 32
JWT_SECRET="troca-isto-por-um-valor-aleatorio-e-longo"

# Duracao da sessao de administrador.
JWT_EXPIRES_IN=7d

# Origens permitidas para CORS, separadas por virgula.
# Em producao (frontend servido pelo mesmo servico) pode ficar vazio.
CORS_ORIGIN=http://localhost:5173

# Administrador criado pelo comando de seed. A password nunca fica no codigo.
# Depois do primeiro seed podes remover estas variaveis - o utilizador ja existe.
ADMIN_EMAIL=pais@exemplo.pt
ADMIN_PASSWORD=escolhe-uma-password-forte
ADMIN_NAME="Pais do Diogo"

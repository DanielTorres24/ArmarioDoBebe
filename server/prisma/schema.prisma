generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado de um artigo, definido pelos pais.
enum ItemStatus {
  NEEDED /// 🟢 Faz falta
  WANTED /// ⭐ Muito desejado
  SOME /// 🟡 Já temos alguns
  OWNED /// 🔴 Já temos
}

enum ReservationStatus {
  THINKING /// Está a pensar oferecer
  RESERVED /// Vai mesmo oferecer
  GIFTED /// Já ofereceu
  CANCELLED
}

/// Quem pode ver o nome de quem reservou, na área pública.
enum ReserverVisibility {
  PUBLIC /// Toda a gente vê o nome
  ADMIN_ONLY /// Só os pais veem o nome
  HIDDEN /// Aparece apenas "Reservado"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(120)
  name         String?  @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

/// Linha única (id = 1) com tudo o que os pais podem personalizar no site.
model SiteSettings {
  id                 Int                @id @default(1)
  babyName           String             @default("Diogo") @map("baby_name") @db.VarChar(60)
  siteName           String             @default("Armário do Diogo") @map("site_name") @db.VarChar(80)
  heroIcon           String             @default("🧸") @map("hero_icon") @db.VarChar(16)
  heroTitle          String             @map("hero_title") @db.VarChar(120)
  heroSubtitle       String             @map("hero_subtitle") @db.VarChar(600)
  primaryCtaLabel    String             @map("primary_cta_label") @db.VarChar(60)
  secondaryCtaLabel  String             @map("secondary_cta_label") @db.VarChar(60)
  preferencesTitle   String             @map("preferences_title") @db.VarChar(120)
  preferencesIntro   String?            @map("preferences_intro") @db.VarChar(600)
  footerText         String             @map("footer_text") @db.VarChar(200)
  reservationEnabled Boolean            @default(true) @map("reservation_enabled")
  allowThinking      Boolean            @default(true) @map("allow_thinking")
  allowCancellation  Boolean            @default(true) @map("allow_cancellation")
  reserverVisibility ReserverVisibility @default(PUBLIC) @map("reserver_visibility")
  reservationTtlDays Int?               @map("reservation_ttl_days")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("site_settings")
}

/// Texto, cor e ícone de cada estado — editável pelos pais.
model StatusSetting {
  id          Int        @id @default(autoincrement())
  status      ItemStatus @unique
  label       String     @db.VarChar(60)
  icon        String     @db.VarChar(16)
  color       String     @db.VarChar(20)
  description String     @db.VarChar(240)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("status_settings")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  icon      String   @default("💙") @db.VarChar(16)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items       Item[]
  suggestions Suggestion[]

  @@index([sortOrder])
  @@map("categories")
}

/// Faixa etária / tamanho, parametrizável pelos pais.
model AgeRange {
  id        String   @id @default(uuid())
  label     String   @db.VarChar(40)
  slug      String   @unique @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@index([sortOrder])
  @@map("age_ranges")
}

model Item {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(600)
  categoryId  String     @map("category_id")
  status      ItemStatus @default(NEEDED)
  priority    Int        @default(2)
  size        String?    @db.VarChar(60)
  ageRangeId  String?    @map("age_range_id")
  quantity    Int        @default(1)
  minPrice    Decimal?   @map("min_price") @db.Decimal(8, 2)
  maxPrice    Decimal?   @map("max_price") @db.Decimal(8, 2)
  productUrl  String?    @map("product_url") @db.VarChar(500)
  isFeatured  Boolean    @default(false) @map("is_featured")
  /// Nulo quando foi criado pelos pais no admin.
  ownerId     String?    @map("owner_id") @db.VarChar(64)
  ownerName   String?    @map("owner_name") @db.VarChar(80)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ageRange     AgeRange?     @relation(fields: [ageRangeId], references: [id], onDelete: SetNull)
  reservations Reservation[]

  @@index([status])
  @@index([categoryId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("items")
}

/// Convidado identificado apenas pelo id gerado no navegador.
model Guest {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(80)
  email     String?  @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("guests")
}

model Reservation {
  id         String            @id @default(uuid())
  itemId     String            @map("item_id")
  guestId    String            @map("guest_id") @db.VarChar(64)
  guestName  String            @map("guest_name") @db.VarChar(80)
  guestEmail String?           @map("guest_email") @db.VarChar(160)
  status     ReservationStatus @default(RESERVED)
  note       String?           @db.VarChar(300)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  expiresAt  DateTime?         @map("expires_at")

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([guestId])
  @@index([status])
  @@map("reservations")
}

model Suggestion {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(600)
  categoryId  String?  @map("category_id")
  minPrice    Decimal? @map("min_price") @db.Decimal(8, 2)
  maxPrice    Decimal? @map("max_price") @db.Decimal(8, 2)
  priority    Int      @default(2)
  productUrl  String?  @map("product_url") @db.VarChar(500)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("suggestions")
}

model ParentPreference {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(400)
  icon        String   @default("💙") @db.VarChar(16)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("parent_preferences")
}
